# PriceHunt Frontend Environment Variables
# Copy this file to .env and update values as needed.

# Base URL for the compare-prices backend API (port 3001)
# This MUST point to the backend, not the frontend.
# e.g. https://your-backend-url.com:3001
VITE_API_URL=http://localhost:3001

# Alternate backend URL variables (also checked by the API client)
VITE_BACKEND_URL=http://localhost:3001
VITE_API_BASE=http://localhost:3001

# Frontend URL (this app)
VITE_FRONTEND_URL=http://localhost:3000

# Application settings
VITE_NODE_ENV=development
VITE_LOG_LEVEL=info
